{
    "version": "0.0.0",
    "name": "base-ui-toc",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gilsmt/base-ui-toc.git"
    },
    "bugs": {
        "url": "https://github.com/gilsmt/base-ui-toc/issues"
    },
    "keywords": [
        "react",
        "react-component",
        "react-components",
        "unstyled",
        "base-ui"
    ],
    "engines": {
        "node": ">=24"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "type-check": "tsc --noEmit",
        "playground:dev": "bun --cwd=playground/vite-app run dev",
        "playground:build": "bun --cwd=playground/vite-app run build"
    },
    "workspaces": [
        "playground/*"
    ],
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@base-ui/utils": "^0.5.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "mitata": "^1.0.34",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "@types/react": "^19",
        "react": "^19",
        "react-dom": "^19"
    }
}
